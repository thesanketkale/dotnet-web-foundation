# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force scripts and workflow files to LF
*.sh text eol=lf
*.ps1 text eol=lf
scripts/verify.sh text eol=lf
.githooks/* text eol=lf
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
