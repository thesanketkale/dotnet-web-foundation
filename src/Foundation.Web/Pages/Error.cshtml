@page
@model Foundation.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="card" style="margin-top: var(--space-8); padding: var(--space-8); text-align: center;">
    <h1 style="color: var(--danger); font-size: var(--text-3xl);">An unexpected error occurred</h1>
    <p class="text-muted">An error occurred while processing your request. Please try again later.</p>

    @if (Model.ShowRequestId)
    {
        <div style="margin-top: var(--space-4); font-size: var(--text-sm); color: var(--text-muted);">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </div>
    }

    <div style="margin-top: var(--space-6);">
        <a asp-page="/Index" class="btn btn-primary">Return to Home</a>
    </div>
</div>
