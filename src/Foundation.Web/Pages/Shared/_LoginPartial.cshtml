@using Microsoft.AspNetCore.Identity
@using Foundation.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="nav-links">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
    {
        <li>
            <a class="nav-link" asp-page="/Admin/Index" style="font-weight: 600; color: var(--primary);">Admin Dashboard</a>
        </li>
    }
    <li>
        <a class="nav-link" asp-page="/Account/Manage/Index" title="Manage Account">
            Profile (@User.Identity?.Name)
        </a>
    </li>
    <li>
        <form class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="nav-link" asp-page="/Account/Register">Register</a>
    </li>
    <li>
        <a class="btn btn-primary btn-sm" asp-page="/Account/Login">Sign In</a>
    </li>
}
</ul>
