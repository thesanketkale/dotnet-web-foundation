@page
@model Foundation.Web.Pages.Account.Manage.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
}

<div class="card" style="padding: var(--space-8);">
    <h2 style="margin-top: 0; font-size: var(--text-2xl);">Configure Authenticator App</h2>

    <div style="margin-top: var(--space-4);">
        <p>To use an authenticator app (such as Google Authenticator, Microsoft Authenticator, or 1Password), follow these steps:</p>
        <ol style="line-height: 1.8;">
            <li>Download an authenticator app on your mobile device.</li>
            <li>
                Enter this key into your authenticator app:
                <div style="margin: var(--space-3) 0;">
                    <kbd style="font-size: var(--text-base); padding: var(--space-2) var(--space-4); background-color: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius-sm);">
                        @Model.SharedKey
                    </kbd>
                </div>
            </li>
            <li>Once configured, enter the 6-digit verification code generated by the app below to activate two-factor authentication.</li>
        </ol>
    </div>

    <form method="post" style="max-width: 400px; margin-top: var(--space-6);">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="form-group">
            <label asp-for="Input.Code" class="form-label">Verification Code</label>
            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="123456" aria-required="true" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>

        <div style="margin-top: var(--space-6);">
            <button type="submit" class="btn btn-primary">Verify & Activate 2FA</button>
            <a asp-page="./TwoFactorAuthentication" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
