@page
@model Foundation.Web.Pages.Account.Manage.DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
}

<div class="card" style="padding: var(--space-8); max-width: 500px;">
    <h2 style="color: var(--danger); margin-top: 0; font-size: var(--text-2xl);">Delete Account & Data</h2>

    <div class="alert alert-danger" role="alert">
        <strong>Warning:</strong> Deleting this data will permanently remove your account and all associated profiles. This cannot be recovered.
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">Confirm Password</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div style="margin-top: var(--space-6); display: flex; gap: var(--space-4);">
            <button type="submit" class="btn btn-danger">Permanently Delete Account</button>
            <a asp-page="./PersonalData" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
