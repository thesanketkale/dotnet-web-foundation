@page
@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="row" style="display: flex; justify-content: center; margin-top: var(--space-8);">
    <div style="width: 100%; max-width: 480px;">
        <div class="card" style="padding: var(--space-8); text-align: center;">
            <h1 style="font-size: var(--text-2xl); margin-top: 0;">Password reset complete</h1>
            <p class="text-muted" style="margin-top: var(--space-4);">
                Your password has been reset successfully.
            </p>
            <div style="margin-top: var(--space-6);">
                <a asp-page="./Login" class="btn btn-primary">Sign In with New Password</a>
            </div>
        </div>
    </div>
</div>
