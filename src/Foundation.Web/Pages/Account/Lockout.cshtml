@page
@{
    ViewData["Title"] = "Locked out";
}

<div class="row" style="display: flex; justify-content: center; margin-top: var(--space-8);">
    <div style="width: 100%; max-width: 480px;">
        <div class="card" style="padding: var(--space-8); text-align: center;">
            <h1 style="color: var(--danger); font-size: var(--text-2xl); margin-top: 0;">Account Locked Out</h1>
            <p class="text-muted" style="margin-top: var(--space-4);">
                This account has been temporarily locked out due to multiple consecutive failed sign-in attempts. Please try again in 15 minutes or reset your password.
            </p>
            <div style="margin-top: var(--space-6); display: flex; gap: var(--space-4); justify-content: center;">
                <a asp-page="./ForgotPassword" class="btn btn-primary">Reset Password</a>
                <a asp-page="./Login" class="btn btn-secondary">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
