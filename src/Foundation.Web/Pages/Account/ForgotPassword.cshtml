@page
@model Foundation.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row" style="display: flex; justify-content: center; margin-top: var(--space-8);">
    <div style="width: 100%; max-width: 440px;">
        <div class="card" style="padding: var(--space-8);">
            <h1 style="font-size: var(--text-2xl); margin-top: 0; text-align: center;">Reset Password</h1>
            <p class="text-muted" style="text-align: center; margin-bottom: var(--space-6);">
                Enter your registered email address and we'll send you a password reset link.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="form-group">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div style="margin-top: var(--space-6);">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Send Reset Link</button>
                </div>
            </form>

            <div style="margin-top: var(--space-6); text-align: center; font-size: var(--text-sm);">
                <a asp-page="./Login">Back to Sign In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
