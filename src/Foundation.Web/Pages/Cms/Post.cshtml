@page "/blog/{slug}"
@model Foundation.Web.Pages.Cms.PostViewerModel
@{
    ViewData["Title"] = Model.CmsPost?.Title ?? "Post";
}

<article class="cms-article card" style="margin-top: var(--space-8); padding: var(--space-8);">
    @if (Model.CmsPost != null)
    {
        <header style="border-bottom: 1px solid var(--border); padding-bottom: var(--space-4); margin-bottom: var(--space-6);">
            <h1 style="font-size: var(--text-3xl); margin-top: 0; color: var(--text-heading);">@Model.CmsPost.Title</h1>
            <div class="text-muted" style="font-size: var(--text-sm); display: flex; gap: var(--space-4); align-items: center;">
                <span>By <strong>Editorial Team</strong></span>
                <span>•</span>
                <span>Published @(Model.CmsPost.PublishedAtUtc?.ToString("MMMM dd, yyyy") ?? Model.CmsPost.CreatedAtUtc.ToString("MMMM dd, yyyy"))</span>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.CmsPost.Summary))
        {
            <div class="lead" style="font-size: var(--text-lg); font-weight: 500; margin-bottom: var(--space-6); color: var(--text-muted);">
                @Model.CmsPost.Summary
            </div>
        }

        <div class="cms-content" style="line-height: 1.7; font-size: var(--text-base);">
            @Html.Raw(Model.CmsPost.ContentHtml)
        </div>
    }
</article>
