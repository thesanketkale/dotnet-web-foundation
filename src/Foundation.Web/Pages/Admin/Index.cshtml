@page
@model Foundation.Web.Pages.Admin.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div>
    <h1 style="font-size: var(--text-2xl); margin-top: 0;">Administration Dashboard</h1>
    <p class="text-muted">System metrics, content overview, and recent activity.</p>

    <!-- Key Metrics Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); margin: var(--space-6) 0;">
        <div class="card" style="padding: var(--space-6); text-align: center;">
            <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--primary);">@Model.TotalUsers</div>
            <div class="text-muted" style="font-size: var(--text-sm); margin-top: var(--space-2);">Total Users</div>
        </div>
        <div class="card" style="padding: var(--space-6); text-align: center;">
            <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--primary);">@Model.TotalPages</div>
            <div class="text-muted" style="font-size: var(--text-sm); margin-top: var(--space-2);">CMS Pages</div>
        </div>
        <div class="card" style="padding: var(--space-6); text-align: center;">
            <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--primary);">@Model.TotalPosts</div>
            <div class="text-muted" style="font-size: var(--text-sm); margin-top: var(--space-2);">Blog Posts</div>
        </div>
        <div class="card" style="padding: var(--space-6); text-align: center;">
            <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--primary);">@Model.TotalMedia</div>
            <div class="text-muted" style="font-size: var(--text-sm); margin-top: var(--space-2);">Media Files</div>
        </div>
    </div>

    <!-- Recent Audit Activity -->
    <div class="card" style="padding: var(--space-6); margin-top: var(--space-6);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <h2 style="font-size: var(--text-lg); margin: 0;">Recent Audit Activity</h2>
            <a asp-page="/Admin/Audit/Index" style="font-size: var(--text-sm);">View all logs &rarr;</a>
        </div>

        @if (Model.RecentAudits.Count == 0)
        {
            <p class="text-muted" style="margin: var(--space-4) 0;">No audit records found.</p>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border); text-align: left;">
                            <th style="padding: var(--space-3);">Timestamp (UTC)</th>
                            <th style="padding: var(--space-3);">Entity</th>
                            <th style="padding: var(--space-3);">Action</th>
                            <th style="padding: var(--space-3);">User ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var audit in Model.RecentAudits)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: var(--space-3);">@audit.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td style="padding: var(--space-3); font-weight: 600;">@audit.EntityName</td>
                                <td style="padding: var(--space-3);">
                                    <span class="badge @(audit.Action == Foundation.Domain.Enums.AuditAction.Create ? "badge-success" : audit.Action == Foundation.Domain.Enums.AuditAction.Delete ? "badge-danger" : "badge-info")" style="padding: 2px 8px; border-radius: var(--radius-sm); font-size: var(--text-xs); border: 1px solid var(--border);">
                                        @audit.Action
                                    </span>
                                </td>
                                <td style="padding: var(--space-3); font-family: monospace;">@(audit.UserId?.ToString() ?? "System")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
