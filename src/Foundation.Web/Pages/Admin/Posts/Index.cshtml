@page
@model Foundation.Web.Pages.Admin.Posts.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Blog Posts";
}

<div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6);">
        <div>
            <h1 style="font-size: var(--text-2xl); margin: 0;">Blog Posts</h1>
            <p class="text-muted" style="margin-top: var(--space-1); margin-bottom: 0;">Publish blog articles and updates.</p>
        </div>
        <div>
            <a asp-page="./Edit" class="btn btn-primary">+ New Post</a>
        </div>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        @if (Model.PostsList == null || Model.PostsList.Items.Count == 0)
        {
            <div style="padding: var(--space-6); text-align: center;" class="text-muted">
                No blog posts created yet.
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
                    <thead>
                        <tr style="background-color: var(--surface-alt); border-bottom: 2px solid var(--border); text-align: left;">
                            <th style="padding: var(--space-4);">Title</th>
                            <th style="padding: var(--space-4);">Slug</th>
                            <th style="padding: var(--space-4);">Author</th>
                            <th style="padding: var(--space-4);">Status</th>
                            <th style="padding: var(--space-4);">Published Date</th>
                            <th style="padding: var(--space-4); text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.PostsList.Items)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: var(--space-4); font-weight: 600;">
                                    <a asp-page="./Edit" asp-route-id="@post.Id">@post.Title</a>
                                </td>
                                <td style="padding: var(--space-4); font-family: monospace;">
                                    <a href="/blog/@post.Slug" target="_blank" rel="noopener noreferrer">/blog/@post.Slug</a>
                                </td>
                                <td style="padding: var(--space-4);">@post.AuthorId.ToString()[..8]</td>
                                <td style="padding: var(--space-4);">
                                    <span class="badge @(post.Status == Foundation.Domain.Enums.ContentStatus.Published ? "badge-success" : "badge-warning")" style="padding: 2px 8px; border-radius: var(--radius-sm); border: 1px solid var(--border);">
                                        @post.Status
                                    </span>
                                </td>
                                <td style="padding: var(--space-4);">@(post.PublishedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td style="padding: var(--space-4); text-align: right;">
                                    <div style="display: inline-flex; gap: var(--space-2); align-items: center;">
                                        <a asp-page="./Edit" asp-route-id="@post.Id" class="btn btn-secondary btn-sm">Edit</a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@post.Id" onsubmit="return confirm('Are you sure you want to delete this blog post?');" style="display: inline;">
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
