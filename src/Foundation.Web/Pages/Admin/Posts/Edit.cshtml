@page "{id:guid?}"
@model Foundation.Web.Pages.Admin.Posts.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.IsNew ? "Create Blog Post" : "Edit Blog Post";
}

<div class="card" style="padding: var(--space-8);">
    <h2 style="margin-top: 0; font-size: var(--text-2xl);">@(Model.IsNew ? "Create Blog Post" : "Edit Blog Post")</h2>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="form-group">
            <label asp-for="Input.Title" class="form-label">Post Title</label>
            <input asp-for="Input.Title" class="form-control" aria-required="true" placeholder="e.g. Modern Architecture with .NET 10" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Slug" class="form-label">URL Slug</label>
            <input asp-for="Input.Slug" class="form-control" aria-required="true" placeholder="modern-architecture-dotnet-10" />
            <span asp-validation-for="Input.Slug" class="text-danger"></span>
            <small class="text-muted">Will be accessible at /blog/{slug}</small>
        </div>

        <div class="form-group">
            <label asp-for="Input.Summary" class="form-label">Summary / Excerpt (Optional)</label>
            <textarea asp-for="Input.Summary" class="form-control" rows="2" placeholder="Brief summary of the article for listings..."></textarea>
            <span asp-validation-for="Input.Summary" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.MarkdownContent" class="form-label">Markdown Content</label>
            <textarea asp-for="Input.MarkdownContent" class="form-control" rows="15" style="font-family: monospace;" placeholder="# Introduction&#10;&#10;Write post in markdown..."></textarea>
            <span asp-validation-for="Input.MarkdownContent" class="text-danger"></span>
            <small class="text-muted">Markdown is parsed via Markdig and sanitized via HtmlSanitizer.</small>
        </div>

        <div class="form-group" style="display: flex; align-items: center; gap: var(--space-2);">
            <input asp-for="Input.PublishImmediately" id="publishPostCheckbox" type="checkbox" />
            <label for="publishPostCheckbox" style="font-size: var(--text-sm); margin: 0;">Published (visible to public)</label>
        </div>

        <div style="margin-top: var(--space-6); display: flex; gap: var(--space-4);">
            <button type="submit" class="btn btn-primary">Save Post</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
