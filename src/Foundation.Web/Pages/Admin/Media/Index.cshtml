@page
@model Foundation.Web.Pages.Admin.Media.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Media Library";
}

<div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6);">
        <div>
            <h1 style="font-size: var(--text-2xl); margin: 0;">Media Library</h1>
            <p class="text-muted" style="margin-top: var(--space-1); margin-bottom: 0;">Upload and manage images and assets for CMS articles.</p>
        </div>
    </div>

    <!-- Upload Form -->
    <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-6);">
        <h2 style="font-size: var(--text-lg); margin-top: 0;">Upload New Asset</h2>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" style="display: flex; gap: var(--space-4); align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
                <label asp-for="UploadFile" class="form-label">Select Image File</label>
                <input asp-for="UploadFile" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="form-control" />
                <small class="text-muted">Allowed types: PNG, JPEG, WEBP, SVG (Max 10MB).</small>
            </div>
            <div>
                <button type="submit" class="btn btn-primary">Upload Asset</button>
            </div>
        </form>
    </div>

    <!-- Media Grid -->
    <div class="card" style="padding: 0; overflow: hidden;">
        @if (Model.MediaList == null || Model.MediaList.Items.Count == 0)
        {
            <div style="padding: var(--space-6); text-align: center;" class="text-muted">
                No media files uploaded yet.
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
                    <thead>
                        <tr style="background-color: var(--surface-alt); border-bottom: 2px solid var(--border); text-align: left;">
                            <th style="padding: var(--space-4); width: 80px;">Preview</th>
                            <th style="padding: var(--space-4);">File Name</th>
                            <th style="padding: var(--space-4);">Content Type</th>
                            <th style="padding: var(--space-4);">Size</th>
                            <th style="padding: var(--space-4);">Uploaded (UTC)</th>
                            <th style="padding: var(--space-4); text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var media in Model.MediaList.Items)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: var(--space-4);">
                                    <div style="width: 48px; height: 48px; border-radius: var(--radius-sm); border: 1px solid var(--border); overflow: hidden; background-color: var(--surface-alt); display: flex; align-items: center; justify-content: center;">
                                        <img src="@media.PublicUrl" alt="@media.OriginalFileName" style="max-width: 100%; max-height: 100%; object-fit: cover;" />
                                    </div>
                                </td>
                                <td style="padding: var(--space-4); font-weight: 600;">
                                    <div>@media.OriginalFileName</div>
                                    <div style="font-family: monospace; font-size: var(--text-xs); color: var(--text-muted);">
                                        <a href="@media.PublicUrl" target="_blank" rel="noopener noreferrer">@media.PublicUrl</a>
                                    </div>
                                </td>
                                <td style="padding: var(--space-4);">@media.ContentType</td>
                                <td style="padding: var(--space-4);">@((media.FileSizeBytes / 1024.0).ToString("N1")) KB</td>
                                <td style="padding: var(--space-4);">@media.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td style="padding: var(--space-4); text-align: right;">
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@media.Id" onsubmit="return confirm('Are you sure you want to delete this media file?');" style="display: inline;">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
