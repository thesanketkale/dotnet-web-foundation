@page "{id:guid?}"
@model Foundation.Web.Pages.Admin.Pages.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.IsNew ? "Create CMS Page" : "Edit CMS Page";
}

<div class="card" style="padding: var(--space-8);">
    <h2 style="margin-top: 0; font-size: var(--text-2xl);">@(Model.IsNew ? "Create CMS Page" : "Edit CMS Page")</h2>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="form-group">
            <label asp-for="Input.Title" class="form-label">Page Title</label>
            <input asp-for="Input.Title" class="form-control" aria-required="true" placeholder="e.g. Terms of Service" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Slug" class="form-label">URL Slug</label>
            <input asp-for="Input.Slug" class="form-control" aria-required="true" placeholder="terms-of-service" />
            <span asp-validation-for="Input.Slug" class="text-danger"></span>
            <small class="text-muted">Will be accessible at /p/{slug}</small>
        </div>

        <div class="form-group">
            <label asp-for="Input.MarkdownContent" class="form-label">Markdown Content</label>
            <textarea asp-for="Input.MarkdownContent" class="form-control" rows="15" style="font-family: monospace;" placeholder="# Heading&#10;&#10;Write markdown here..."></textarea>
            <span asp-validation-for="Input.MarkdownContent" class="text-danger"></span>
            <small class="text-muted">Markdown will be safely rendered and sanitized with HtmlSanitizer.</small>
        </div>

        <div class="form-group" style="display: flex; align-items: center; gap: var(--space-2);">
            <input asp-for="Input.PublishImmediately" id="publishCheckbox" type="checkbox" />
            <label for="publishCheckbox" style="font-size: var(--text-sm); margin: 0;">Published (visible to public)</label>
        </div>

        <div style="margin-top: var(--space-6); display: flex; gap: var(--space-4);">
            <button type="submit" class="btn btn-primary">Save Page</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
