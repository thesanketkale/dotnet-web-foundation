{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsAtStartup": true
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025
  },
  "OpenTelemetry": {
    "EnableConsoleExporter": false
  }
}
